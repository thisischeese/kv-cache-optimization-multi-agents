# --- LLM ---
OPENAI_API_KEY=your_openai_api_key

# --- HuggingFace embedding (RAG 단계에서 사용 예정, 현재 스캐폴딩에서는 미사용) ---
# gated/private 모델을 받을 때만 필요. 공개 모델이면 비워둬도 된다.
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token

# 임베딩 모델 repo id. 영문 논문 + 한국어 보고서를 함께 다루므로 multilingual 모델 기준.
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# 추론 디바이스: cpu | cuda | mps (Apple Silicon은 mps)
EMBEDDING_DEVICE=mps

# 모델 가중치 캐시 경로. 미지정 시 ~/.cache/huggingface 사용.
HF_HOME=./.cache/huggingface

QDRANT_API_KEY=your_qdrant_api_key
QDRANT_ENDPOINT=https://c99e862e-573d-4c1c-b091-c8be42b02c34.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_COLLECTION=kv_cache_docs_v1