# --- LLM ---
OPENAI_API_KEY=your_openai_api_key

# --- HuggingFace embedding (RAG 단계에서 사용 예정, 현재 스캐폴딩에서는 미사용) ---
# Hugging Face Hub token. 공개 모델이면 비워둬도 되지만, 설정하면 rate limit이 완화된다.
HF_TOKEN=your_huggingface_token

# Legacy alias. 비워둬도 된다. HF_TOKEN이 우선이다.
HUGGINGFACEHUB_API_TOKEN=

# 임베딩 모델 repo id. 영문 논문 + 한국어 보고서를 함께 다루므로 multilingual 모델 기준.
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# 추론 디바이스: cpu | cuda | mps (Apple Silicon은 mps)
EMBEDDING_DEVICE=cpu

# 모델 가중치 캐시 경로. 미지정 시 ~/.cache/huggingface 사용.
HF_HOME=./.cache/huggingface

# 읽기 전용 API Key로 이미 문서가 적재된 Qdrant collection에 접근할 때 사용합니다.  
QDRANT_API_KEY=
QDRANT_ENDPOINT=https://your-qdrant-cluster.example.cloud.qdrant.io
QDRANT_COLLECTION=kv_cache_docs_v2
# 기존 collection이 named vector를 쓰는 경우에만 지정한다. 새 collection은 비워두면 unnamed vector로 생성된다.
QDRANT_VECTOR_NAME=

# --- 종합(synthesis) LLM ---
# 키가 있으면 synthesis가 LLM을 호출한다. 없으면 규칙 기반 fallback으로 동작.
LLM_MODEL=gpt-4.1-mini

# --- PDF ---
# 한글 TTF 경로. 비우면 OS 기본 폰트(AppleGothic/맑은 고딕/NanumGothic) → reportlab 내장 CID 폰트 순으로 쓴다.
PDF_FONT_PATH=
